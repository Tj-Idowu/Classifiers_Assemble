// SLURM configuration. Submit with: nextflow run main.nf -profile slurm
profiles {
    slurm {
        process.executor = 'slurm'
        process.queue = params.slurm_queue ?: null
        process.clusterOptions = params.slurm_cluster_options ?: ''
        executor {
            queueSize = params.slurm_queue_size ?: 50
            submitRateLimit = params.slurm_submit_rate_limit ?: '10/1min'
        }
    }
    local {
        process.executor = 'local'
    }
}

conda {
    enabled = true
    cacheDir = "${System.getenv('HOME')}/.conda/envs/nextflow"
}

process {
    errorStrategy = 'terminate'
    maxRetries = 1
    scratch = true
    withLabel: blast     { cpus = 8;  memory = '16 GB'; time = '5h' }
    withLabel: centrifuge{ cpus = 8;  memory = '32 GB'; time = '200h' }
    withLabel: clark     { cpus = 8;  memory = '32 GB'; time = '150h' }
    withLabel: kma       { cpus = 4;  memory = '32 GB'; time = '120h' }
    withLabel: kraken2   { cpus = 2;  memory = '16 GB'; time = '100h' }
    withLabel: bracken   { cpus = 1;  memory = '8 GB';  time = '2h' }
    withLabel: metaphlan { cpus = 8;  memory = '32 GB'; time = '120h' }
}

params {
    outdir = 'results'
    slurm_queue = null
    slurm_cluster_options = ''
    slurm_queue_size = 50
    slurm_submit_rate_limit = '10/1min'

    run_blast = false
    blast_input = 'Benchmarking/Metagenomes/FASTA/*.fasta'
    blast_db = 'Benchmarking/Metagenomes/BLAST_DB/all_genomes'
    blast_perc_identity = 98
    blast_qcov_hsp_perc = 100

    run_centrifuge = false
    centrifuge_sample_sheet = 'centrifuge_sample-sheet.tsv'
    centrifuge_index = 'centrifuge_DB/p_compressed'

    run_clark = false
    clark_home = './CLARK'
    clark_read1 = 'zero_F.txt'
    clark_read2 = 'zero_R.txt'
    clark_sample = 'zero'

    run_kma = false
    kma_input_dir = 'Benchmarking/Metagenomes/Wastewater'
    kma_db = 'Benchmarking/compress_ncbi_nt/ncbi_nt'
    kma_exe = 'Benchmarking/Metagenomes/kma/kma'

    run_kraken2 = false
    run_bracken = true
    kraken_input_dir = 'Benchmarking/Metagenomes/Wastewater'
    kraken_db = 'Benchmarking/k2_standard_08gb_20230314'
    bracken_read_length = 150
    bracken_level = 'S'
    bracken_threshold = 5

    run_metaphlan = false
    metaphlan_input_dir = 'Benchmarking/Metagenomes/Wastewater'
    metaphlan_glob = '*f2*_R1.fastq.gz'
    metaphlan_suffix = '_R1.fastq.gz'
    metaphlan_db = 'Benchmarking/Metagenomes/metaphlan_databases'
    metaphlan_index = 'mpa_vOct22_CHOCOPhlAnSGB_202212'

    fastq_r1_suffix = '_R1.fastq'
    fastq_r2_suffix = '_R2.fastq'
}
